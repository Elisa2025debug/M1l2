# Importando funções
import random
import string
import time

# Função para gerar senha
def gerar_senha():
    comprimento = int(input("Digite o comprimento da senha desejada: "))
    time.sleep(1)

    caracteres = string.ascii_letters + string.digits + string.punctuation
    senha_gerada = ""

    for i in range(comprimento):
        senha_gerada = senha_gerada + random.choice(caracteres)

    print("Sua nova senha aleatória é: " + senha_gerada)
    time.sleep(2)
    print(" ")

    add = input("Deseja adicionar essa senha em sua lista (sim/não)? ")

    if add.lower() == "sim":
        print(" ")
        time.sleep(1)
        nameS = input("Digite o nome da senha: ")
        password[nameS] = senha_gerada
        time.sleep(1)
        print("Senhas:", password)
    else:
        print("Ok, agradecemos por testar!")

# Função para opção inválida
def sorry():
    print("Sinto muito...")
    time.sleep(1)
    print("Não temos essa opção.")

password = {}

while True:

    print("Escolha um dos comandos:")
    print("1 - Mostrar")
    print("2 - Sugerir")
    print("3 - Adicionar")
    print("4 - Remover")

    command = input("- ")

    print(" ")
    time.sleep(1)

    if command == "1":

        if not password:
            print("Sem senhas para mostrar.")
        else:
            print("Aqui estão as suas senhas:")
            for nome in password:
                print(nome + " : " + password[nome])

    elif command == "2":

        gerar_senha()

    elif command == "3":

        nameS3 = input("Digite o nome da senha: ")
        time.sleep(1)
        word = input("Digite a senha: ")

        password[nameS3] = word

        print(" ")
        print("Senhas:", password)

    elif command == "4":

        if not password:
            print("Sem senhas para excluir.")
        else:
            nameS4 = input("Digite o nome da senha que deseja remover: ")

            if nameS4 in password:
                del password[nameS4]
                print("Senha removida com sucesso!")
            else:
                print("Senha não encontrada.")

    elif command == "5":

        if not password:
            print("Não há senhas para apagar.")
        else:
            password.clear()
            print("Todas as senhas foram apagadas.")

    elif command == "6":

        print("Muito obrigado por usar o programa!")
        time.sleep(1)
        print("Espero te ver de novo!")
        print("（^∀^●）ﾉｼ")
        break

    else:

        sorry()

    time.sleep(2)
    print(" ")
